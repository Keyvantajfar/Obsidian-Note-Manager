Screen { layout: vertical; }
#statusbar { height: 1; background: $panel; }
#msgbar { height: 1; padding: 0 1; color: $text-muted; }
#cmdbar { margin: 0 1; border: tall $accent; }
TabbedContent { height: 1fr; }
TabPane { padding: 0; }
Tabs { height: 3; }

.pane-title { background: $boost; padding: 0 1; height: auto; text-style: bold; }
.helpline { height: auto; color: $text-muted; padding: 0 1; }
.toolbar { height: auto; padding: 0 1; }
.toolbar > * { margin-right: 1; }
.toolbar Button { min-width: 8; }
.toolbar Select { width: 34; }
.toolbar Input { width: 28; }
.toolbar Input.tiny, Input.tiny { width: 7; }
.toolbar Label { padding: 1 1 0 0; }
.toolbar Checkbox { width: auto; }
Input.tiny { width: 9; }
.switchrow { height: auto; }
.switchrow Label { padding: 1 1 0 1; }
.buttons { height: auto; margin-top: 1; }
.buttons Button { margin-right: 1; }

/* Explorer */
#ex-left { width: 46%; }
#ex-right { width: 1fr; border-left: solid $primary; }
#ex-tree { height: 1fr; }
#ex-header { height: auto; max-height: 14; padding: 0 1; }
#ex-body { height: 1fr; }

/* Tagger / Stage / Tags / Jobs tables */
#tg-progress { height: auto; padding: 0 1; }
#tg-table, #tv-table, #jb-table { height: 1fr; }
#tg-bar { height: auto; }
#st-main { height: 1fr; }
#st-table { width: 62%; height: 1fr; }
#st-preview { width: 1fr; padding: 0 1; border-left: solid $primary; overflow-y: auto; }
#st-summary, #tv-summary { height: auto; padding: 0 1; }
#jb-table { height: 40%; }
#jb-log { height: 1fr; border-top: solid $primary; }

/* Organizer */
#og-main { height: 2fr; }
#og-cur { width: 24%; }
#og-plan { width: 34%; border-left: solid $primary; }
#og-detail { width: 1fr; border-left: solid $primary; padding: 0 1; }
#og-current, #og-plantree { height: 1fr; }
#og-sugg { height: 6; }
#og-notes { height: 1fr; }
#og-triage { height: 1fr; min-height: 5; }
#og-rules { height: auto; color: $text-muted; }
#og-prefs { width: 1fr; }

/* Rules */
#ru-main { height: 1fr; }
#ru-main > Vertical { width: 1fr; }
#ru-rules, #ru-ins { height: 1fr; }
#ru-cheat { height: auto; padding: 0 1; color: $text-muted; border-top: solid $primary; }

/* Settings */
#se-nav { width: 24; border-right: solid $primary; }
#se-switch { width: 1fr; }
.form { padding: 0 2; height: 1fr; }
.form Label { margin-top: 1; color: $text-muted; }
.small-area { height: 6; }
.mid-area { height: 9; }
#se-schema-table { height: 1fr; }
#se-llm-result { margin-top: 1; height: auto; }

/* Modals */
ModalScreen { align: center middle; }
.dialog { width: 72; height: auto; max-height: 92%; border: thick $primary; background: $surface; padding: 1 2; }
.dialog.wide { width: 92%; max-width: 140; }
.dialog-title { text-style: bold; margin-bottom: 1; }
.dialog-text { margin-bottom: 1; }
.dialog-scroll { height: auto; max-height: 28; }
.dialog-buttons { height: auto; align-horizontal: right; margin-top: 1; }
.dialog-buttons Button { margin-left: 1; }
.dialog DataTable { height: auto; max-height: 20; }
.dialog OptionList { height: 12; }

/* multi-column rows inside forms must size to their content, otherwise they collapse to zero height */
.form .row { height: auto; }
.form .row > Vertical { height: auto; width: 1fr; padding-right: 1; }

/* ---------- home ---------- */
#homeview { height: 1fr; align: center middle; }
#banner { width: 100%; content-align: center middle; text-align: center; color: $primary; text-style: bold; height: 8; padding-top: 1; }
#tagline { width: 100%; text-align: center; color: $text-muted; height: 2; }
#tiles { grid-size: 2 2; grid-gutter: 1 2; width: 84; height: 22; }
.tile { border: heavy $primary 60%; background: $panel; content-align: center middle; text-align: center; height: 100%; padding: 0 2; }
.tile:hover { background: $boost; border: heavy $accent; }
.tile:focus { border: heavy $accent; background: $boost; }
#home-info { width: 100%; text-align: center; height: 2; margin-top: 1; color: $text-muted; }
#home-foot { width: 100%; text-align: center; height: 1; color: $text-muted; }
#workspace { height: 1fr; }
