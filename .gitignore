# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables & AI API keys (Crucial!)
.env
.env.*
!.env.example

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Type checkers & testing caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# IDEs & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vault Manager runtime state: never commit these (they hold your vault's contents/paths and, in profiles.json, API keys)
.vaultmgr/
profiles.json
vaultmgr.log*
